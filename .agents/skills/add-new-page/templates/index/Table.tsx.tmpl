import React from 'react';

import __PageName__TableItem from 'src/__area__/__featureName__/pages/index/__PageName__TableItem';

import { useUniqueKeys } from 'src/shared/lists/get-unique-keys';

import { TableBody, TableColumnHeader, TableHeaderSticky, TableRoot, TableRow } from 'src/toolkit/chakra/table';

interface Props {
  // TODO (api-data): replace `unknown` with the real item type
  items: Array<unknown>;
  isLoading?: boolean;
}

// TODO (api-data): key by the item's identifying fields
const getBaseKey = (item: unknown): string => String(item);

const __PageName__Table = ({ items, isLoading }: Props) => {
  const keys = useUniqueKeys(items, getBaseKey);

  return (
    <TableRoot minWidth="950px">
      <TableHeaderSticky top={ 0 }>
        <TableRow>
          { /* TODO (api-data): define columns */ }
          <TableColumnHeader>Column 1</TableColumnHeader>
          <TableColumnHeader>Column 2</TableColumnHeader>
          <TableColumnHeader>Column 3</TableColumnHeader>
        </TableRow>
      </TableHeaderSticky>
      <TableBody>
        { items.map((item, index) => (
          <__PageName__TableItem key={ keys[index] } item={ item } isLoading={ isLoading }/>
        )) }
      </TableBody>
    </TableRoot>
  );
};

export default __PageName__Table;
