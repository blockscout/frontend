{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "target": "es2022",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false,
    "incremental": false,
    "rootDir": ".",
