{
    "import": [ "frontend-home/configs/cspell/base.jsonc" ],
    // stop at this repository's root: without it cspell also applies the .gitignore of a repository this
    // one is nested in, and checks no files when that one ignores the path. A path, so it cannot come
    // from the imported base.
    "gitignoreRoot": ".",
    "ignorePaths": [
        "**/*.svg",
        "**/*.sfd",
        ".git",
        ".env.*",
        // agent worktrees are full checkouts of the repo — checking them duplicates every file
        ".claude/worktrees",
        "pnpm-lock.yaml",
        "tools/dev-server/.env.localhost",
        "vitest/.env.vitest",
        "playwright/.env.pw",
        "src/features/chain-variants/zeta-chain/mocks/cctx.ts",
        "src/features/address-metadata/mocks/tags.ts",
        "playwright/mocks/file_mock_with_very_long_name.json",
        "playwright/fixtures/rewards.ts",
        "public/static/capybara/index.js",
        "src/toolkit/pages/design-system/utils.ts",
        ".agents/TEAM.md",
        // raw Figma payloads: the designer's layer names are data, not prose
        "tools/design-readout/fixtures",
        // calibration snapshots: the mockups' own layer names and text, plus the Figma file key
        "tools/design-readout/calibration"
    ],
    // words only this repository uses; the shared ones are in the imported base
    "words": [
